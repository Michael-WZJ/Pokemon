<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.michaelj.dao.EvolutionMapper">
    <resultMap id="EvolutionResult" type="com.michaelj.domain.entity.Evolution">
    </resultMap>

    <sql id="BaseColumnMap">
        t0.evol_id, t0.filial_code, t0.paternal_code
    </sql>

    <select id="getEvolCodeList" parameterType="string" resultType="string">
        select paternal_code
        from Evolution t0
        <where>
            t0.deleted = 0
            and filial_code = #{code}
        </where>
        order by paternal_code ASC
    </select>

    <select id="getFilialCodeList" parameterType="string" resultType="string">
        select filial_code
        from Evolution t0
        <where>
            t0.deleted = 0
            and paternal_code = #{code}
        </where>
        order by filial_code ASC
    </select>

    <insert id="saveList" parameterType="java.util.List">
        insert into
        Evolution
        (filial_code, paternal_code)
        values
        <foreach collection="list" item="e" separator=",">
            (#{e.filialCode}, #{e.paternalCode})
        </foreach>
    </insert>

    <update id="update">
        update Evolution
        <set>
            paternal_code = #{paternalCode}
        </set>
        <where>
            deleted = 0
            and filial_code = #{filialCode}
        </where>
    </update>

    <update id="deleteByFilialCode">
        update Evolution
        <set>
            deleted = 1
        </set>
        <where>
            deleted = 0
            and filial_code = #{code}
        </where>
    </update>
</mapper>